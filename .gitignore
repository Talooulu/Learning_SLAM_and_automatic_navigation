# ROS2 编译生成的文件（必须忽略）
build/
install/
log/

# Python 缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE 配置文件（可选）
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
__MACOSX/

# 临时文件
*.tmp
*.bak
*.log

# 备份文件
*.backup
*.old

# 大文件（超过 GitHub 100MB 限制）
*.dae
**/meshes/*.dae
src/su7_gazebo/**/*.dae

# 但保留这些重要文件
!README.md
!LICENSE

