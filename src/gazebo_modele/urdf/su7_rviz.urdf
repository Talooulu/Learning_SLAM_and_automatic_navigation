<?xml version="1.0"?>
<robot name="su7_rviz">
  <!-- 
    这是一个简化的 URDF 文件，仅用于 RViz 显示
    SU7 的实际模型在 Gazebo 中使用 SDF 格式
  -->
  
  <!-- base_link: 机器人主体 -->
  <link name="base_link">
    <!-- 使用多个盒子组合成更真实的汽车形状 -->
    <visual name="body_main">
      <origin xyz="0 0 0.235" rpy="0 0 0"/>
      <geometry>
        <box size="5.24 1.5 0.47"/>
      </geometry>
      <material name="car_body">
        <color rgba="0.2 0.2 0.8 0.9"/>
      </material>
    </visual>
    <!-- 车顶 -->
    <visual name="roof">
      <origin xyz="0.5 0 0.8" rpy="0 0 0"/>
      <geometry>
        <box size="2.5 1.3 0.3"/>
      </geometry>
      <material name="car_roof">
        <color rgba="0.15 0.15 0.7 0.9"/>
      </material>
    </visual>
    <!-- 前保险杠 -->
    <visual name="front_bumper">
      <origin xyz="2.62 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 1.5 0.2"/>
      </geometry>
      <material name="bumper">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <!-- 后保险杠 -->
    <visual name="rear_bumper">
      <origin xyz="-2.62 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 1.5 0.2"/>
      </geometry>
      <material name="bumper">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="5.24 1.5 0.47"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2000"/>
      <inertia ixx="1200" ixy="0" ixz="0" iyy="2500" iyz="0" izz="3000"/>
    </inertial>
  </link>
  
  <!-- lidar3d_link: 激光雷达 -->
  <joint name="lidar3d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar3d_link"/>
    <origin xyz="1.30 0 0.95" rpy="0 0 0"/>
  </joint>
  <link name="lidar3d_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  
  <!-- gps_link: GPS -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.50 0 0.95" rpy="0 0 0"/>
  </joint>
  <link name="gps_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 1.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  
  <!-- imu_link: IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>
      <material name="yellow">
        <color rgba="1.0 1.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  
  <!-- camera_link: 相机 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="2.20 0 0.60" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.15 0.1"/>
      </geometry>
      <material name="cyan">
        <color rgba="0.0 1.0 1.0 0.8"/>
      </material>
    </visual>
  </link>
  
</robot>

